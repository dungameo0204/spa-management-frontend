{
  "name": "spa-management-frontend",
  "private": true,
  "description": "Xuly Spa - Phần mềm quản lý bán hàng, khách hàng và vận hành spa",
  "author": "Xuly Spa",
  "version": "0.1.3",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run icons && vite build",
    "icons": "node desktop/icons.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src",
    "check:vietnamese": "node scripts/check-vietnamese.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node --test desktop/*.test.cjs",
    "desktop": "npm run build && electron .",
    "build:exe": "node desktop/build.cjs",
    "build:installer": "node desktop/build.cjs --installer"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.0.0",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "sharp": "^0.35.5",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vitest": "^3.0.0"
  },
  "build": {
    "appId": "vn.xuly.spa.desktop",
    "productName": "Xuly Spa",
    "compression": "normal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/*.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icons/icon.ico",
      "signExecutable": false
    },
    "publish": { "provider": "github", "owner": "dungameo0204", "repo": "ohina-release" },
    "nsis": { "artifactName": "Xuly-Spa-Setup-${version}.exe", "oneClick": false, "perMachine": false },
    "portable": {
      "artifactName": "Xuly-Spa-${version}-portable.exe"
    }
  }
}
